# Local development only. Do not commit real secrets.
# In production set these in the hosting dashboard, not in this file.

# Required for the admin dashboard. Use a long random password.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional; falls back to ADMIN_PASSWORD for signing the admin cookie.
ADMIN_SESSION_SECRET=

# Production database. Leave empty locally to use data/rfqs.json.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Comma-separated browser origins allowed to call POST /api/rfq.
# The public Maozi site is same-origin with the live app only when the app
# serves the frontend. Add the Maozi origin if you point the static copy here.
# ALLOWED_ORIGINS=https://asterprecision-10n3k3ol.maozi.io

# Optional email notification. The admin dashboard works without these.
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# FROM_EMAIL=Aster Demo <onboarding@resend.dev>

# Local JSON store path (ignored when DATABASE_URL is set).
# DATA_FILE=./data/rfqs.json
